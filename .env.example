# Only the live stages (calibrate, dryrun, batch) need these.
# Every analysis command in README Section 10.1 runs without them.
SOC4AI_GCP_KEY=/path/to/service-account-key.json
SOC4AI_GCP_PROJECT=your-gcp-project-id
SOC4AI_GCP_LOCATION=us-central1
# Optional pin: first 16 hex chars of the key file's SHA-256
SOC4AI_KEY_SHA256_PREFIX=
